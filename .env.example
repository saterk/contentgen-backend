# Copy to backend/.env. Backend settings; see app/config.py for all options.

# LLM
LLM_PROVIDER=mock                 # mock | openrouter | openai (any OpenAI-compatible API via LLM_BASE_URL)
LLM_MODEL=mock-llm-1              # pin the model id, e.g. qwen/qwen3.7-flash on OpenRouter
LLM_API_KEY=
LLM_BASE_URL=                     # empty = provider default (https://openrouter.ai/api/v1 for openrouter)
LLM_REASONING=off                 # off | low | medium | high (OpenRouter reasoning models; off is ~5x faster)
JUDGE_ENABLED=true                # false = copy and image checks use rules only
JUDGE_MODEL=                      # empty = same as LLM_MODEL

# Image
IMAGE_PROVIDER=mock               # mock | openai | azure_foundry | bedrock | other (only mock is built so far)
IMAGE_MODEL=mock-image-1
IMAGE_API_KEY=
IMAGE_SIZE=1080x1350
IMAGE_VARIANTS=1

# Knowledge base
VECTOR_STORE=local                # local (JSON file in data/kb) | chroma (Chroma Cloud or self-hosted)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=content_creator_kb   # the embedding model name is appended automatically
CHROMA_HOST=                      # empty = Chroma Cloud; set for a self-hosted server
EMBEDDING_PROVIDER=mock          # mock | openrouter | openai
EMBEDDING_MODEL=mock-embed-1      # multilingual, handles Thai, e.g. openai/text-embedding-3-small
EMBEDDING_API_KEY=                # empty = LLM_API_KEY
EMBEDDING_BASE_URL=               # empty = LLM_BASE_URL / provider default
# Thresholds depend on the embedding model. For text-embedding-3-small use 0.6 / 0.08 / 0.85.
KM_MATCH_THRESHOLD=0.75
KM_AMBIGUITY_MARGIN=0.03
VARIETY_THRESHOLD=0.9

# App
DATABASE_URL=                     # empty = sqlite file at DATA_DIR/app.db
DATA_DIR=./data                   # relative to the repo root
MAX_CONCURRENT_JOBS=4
MAX_PIECES_PER_REQUEST=10
ITEM_TIMEOUT_SECONDS=180          # per piece: brief, checks, images and retries
REQUEST_TIMEOUT_SECONDS=600       # whole chat request
PROMPT_VERSION=v1
APP_API_KEY=                      # long random string for scripts / SDK calls; empty = API-key access off

# Web login (prototype: one fixed user)
AUTH_USERNAME=
AUTH_PASSWORD_HASH=               # python -m app.auth hash-password
AUTH_SECRET=                      # random string that signs session tokens
AUTH_SESSION_HOURS=12
CORS_ORIGINS=http://localhost:3000

# Chat defaults
DEFAULT_CHANNEL=line
DEFAULT_LANGUAGE=th
DEFAULT_OBJECTIVE=Invite to talk to an advisor
